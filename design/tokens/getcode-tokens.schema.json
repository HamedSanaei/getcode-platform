{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetCode design token snapshot",
  "type": "object",
  "required": ["meta", "sets"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": [
        "snapshotVersion",
        "penpotFileId",
        "designSystemVersion",
        "namedVersion",
        "fileRevision",
        "exportedAtUtc",
        "tokenSetNames",
        "tokenCounts"
      ],
      "properties": {
        "snapshotVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "penpotFileId": { "type": "string", "format": "uuid" },
        "penpotFileName": { "type": "string" },
        "designSystemVersion": { "type": "string" },
        "namedVersion": { "type": "string" },
        "fileRevision": { "type": "string", "pattern": "^\\d+$" },
        "exportedAtUtc": { "type": "string", "format": "date-time" },
        "tokenSetNames": {
          "type": "array",
          "minItems": 3,
          "items": {
            "enum": ["GetCode/Core", "GetCode/Brand/GetCode", "GetCode/Brand/PlusPremium"]
          }
        },
        "tokenCounts": {
          "type": "object",
          "propertyNames": { "enum": ["GetCode/Core", "GetCode/Brand/GetCode", "GetCode/Brand/PlusPremium"] },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "sets": {
      "type": "object",
      "propertyNames": { "enum": ["GetCode/Core", "GetCode/Brand/GetCode", "GetCode/Brand/PlusPremium"] },
      "additionalProperties": {
        "type": "object",
        "required": ["active", "tokens"],
        "properties": {
          "active": { "type": "boolean" },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type", "value"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^(color|space|radius|border|font|opacity)([.][A-Za-z0-9]+)+$"
                },
                "type": {
                  "enum": [
                    "color",
                    "spacing",
                    "borderRadius",
                    "borderWidth",
                    "fontFamilies",
                    "fontSizes",
                    "fontWeights",
                    "opacity"
                  ]
                },
                "value": {
                  "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
