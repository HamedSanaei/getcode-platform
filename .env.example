# Replace before deployment. The independent domain is intentionally unknown in the starter.
GETCODE_PRIMARY_HOST=getcode.example
GETCODE_PLUSPREMIUM_HOST=vnumber.pluspremium.ir
GETCODE_CANONICAL_HOST=getcode.example

POSTGRES_DB=getcode
POSTGRES_USER=getcode
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379

ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=getcode;Username=getcode;Password=change-me-local-only
Redis__Configuration=redis:6379

SiteHosts__RejectUnknownHosts=false
SiteHosts__CanonicalKey=primary
SiteHosts__Hosts__0__Key=primary
SiteHosts__Hosts__0__Host=getcode.example
SiteHosts__Hosts__0__PublicBaseUrl=https://getcode.example
SiteHosts__Hosts__0__BrandKey=getcode
SiteHosts__Hosts__0__IsCanonical=true
SiteHosts__Hosts__1__Key=pluspremium
SiteHosts__Hosts__1__Host=vnumber.pluspremium.ir
SiteHosts__Hosts__1__PublicBaseUrl=https://vnumber.pluspremium.ir
SiteHosts__Hosts__1__BrandKey=getcode-pluspremium
SiteHosts__Hosts__1__IsCanonical=false

LogStorage__RootPath=/data/logs
LogStorage__ArchiveIntervalMinutes=60
LogStorage__AutomaticRetentionMonths=0

INTERNAL_API_URL=http://api:8080
