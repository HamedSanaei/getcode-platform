# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props global.json GetCode.sln ./
COPY backend/src ./backend/src
RUN dotnet restore backend/src/GetCode.Api/GetCode.Api.csproj
RUN dotnet publish backend/src/GetCode.Api/GetCode.Api.csproj -c Release -o /out --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080 \
    TZ=UTC
RUN adduser --disabled-password --home /app --gecos "" getcode && mkdir -p /data/logs && chown -R getcode:getcode /app /data
COPY --from=build /out ./
USER getcode
EXPOSE 8080
ENTRYPOINT ["dotnet", "GetCode.Api.dll"]
